# Your site's public address, used for canonical links, the sitemap and
# share images. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: where form submissions are sent, as a JSON POST. Any tool that
# accepts webhooks works (Zapier, Make, Slack, Formspree, your CRM). Without
# these, submissions are printed in the server log.
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
# The waitlist webhook may answer with {"position": 214} to show people their place in line.
WAITLIST_WEBHOOK_URL=

# Shows a floating colour-theme picker, for demo sites. Leave unset on your own site.
NEXT_PUBLIC_DEMO_MODE=

# Optional: your backend's base URL, e.g. https://api.example.com/v1. When set,
# pages load their content from it (same paths and JSON as src/app/api)
# instead of the dummy data in src/data. Leave unset to use the dummy data.
API_URL=
