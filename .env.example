# Your site's public address, used for canonical links, the sitemap and
# share images. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: where form submissions are sent, as a JSON POST. Any tool that
# accepts webhooks works (Zapier, Make, Slack, Formspree, your CRM). Without
# these, submissions are printed in the server log.
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
